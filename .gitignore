# Maven build output
target/
*.class

# Package files
*.jar
*.war
*.ear

# EXCEPTION: Allow committed JARs in libs/ (loz-engine bundle)
!libs/**/*.jar

# Maven metadata / checksums
**/maven-metadata*.xml
**/*.lastUpdated
**/*.sha1
**/*.md5
**/_remote.repositories
**/resolver-status.properties

# Player code — not tracked (all player-written classes stay local)
/src/main/java/com/mservices/games/game/

# JVM crash logs
hs_err_pid*
replay_pid*

# IntelliJ IDEA
.idea/
*.iml
out/

# VS Code
.vscode/

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# Eclipse / Spring Tool Suite
.project
.classpath
.settings/
.metadata/

# Editor temp files
*.swp
*.swo
*~

# OS-generated files
.DS_Store
Thumbs.db

# Game state (local only)
.quest-state.json
.loz_progress
*.db

# Maven wrapper
.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml